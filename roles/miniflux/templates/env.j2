DATABASE_URL=postgres://miniflux:{{ secrets.postgres.apps.miniflux | urlencode | replace('/', '%2F') }}@db.{{ inventory_hostname }}.{{ domain }}:{{ postgres.port }}/miniflux?sslmode=verify-full
DATABASE_MAX_CONNS={{ postgres.apps.miniflux.conn_limit - 5 }}
RUN_MIGRATIONS=1
CREATE_ADMIN=1
ADMIN_USERNAME={{ miniflux.admin }}
ADMIN_PASSWORD={{ secrets.miniflux.admin }}
LISTEN_ADDR=127.0.0.1:{{ miniflux.port }}
BASE_URL=https://rss.{{ inventory_hostname }}.{{ domain }}
