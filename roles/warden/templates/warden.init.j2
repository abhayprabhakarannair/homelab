#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 -m warden
	procd_set_param env PYTHONPATH=/opt/warden PYTHONDONTWRITEBYTECODE=1 $(grep '^WARDEN_' /etc/warden/env)
	procd_set_param user warden
	procd_set_param group warden
	procd_set_param no_new_privs 1
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
