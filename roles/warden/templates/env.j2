WARDEN_MQTT_HOST={{ mqtt.funnel_host }}
WARDEN_MQTT_PORT={{ mqtt.funnel_port }}
WARDEN_MQTT_USER={{ inventory_hostname }}
WARDEN_MQTT_PASSWORD_FILE=/etc/warden/password
WARDEN_TOPIC={{ topic_root }}/{{ inventory_hostname }}
WARDEN_MODULES={{ warden_modules | join(',') }}
WARDEN_GRACE_S={{ warden_grace_s | default(10) }}
{% if warden_disks is defined %}
WARDEN_DISKS={{ warden_disks | join(',') }}
{% endif %}
{% if 'wake' in warden_modules %}
WARDEN_WAKE_TARGETS={% for name in warden_wakes %}{{ name }}={{ secrets.wol[name].mac }}@{{ secrets.wol[name].ip }}{{ '' if loop.last else ',' }}{% endfor %}

WARDEN_WAKE_BROADCAST={{ lan_broadcast }}
{% endif %}
{% if 'wan' in warden_modules %}
WARDEN_WANS={% for wan in wans %}{{ wan.name }}=wan_{{ wan.name }}/{{ wan.device }}{{ '' if loop.last else ',' }}{% endfor %}

WARDEN_WAN_CAPS={{ wans | selectattr('cap_gb', 'defined') | map(attribute='name') | zip(wans | selectattr('cap_gb', 'defined') | map(attribute='cap_gb')) | map('join', '=') | join(',') }}
WARDEN_WAN_PREFERENCES={% for device, isp in (wan_preferences | default({})) | dictsort %}{{ dhcp_hosts[device].ip }}={{ isp }}{{ '' if loop.last else ',' }}{% endfor %}

{% endif %}
{% if 'clients' in warden_modules %}
WARDEN_LAN={{ lan_cidr }}
{% if warden_wifi_api is defined %}
WARDEN_WIFI_API={{ warden_wifi_api }}
WARDEN_WIFI_USER=warden
WARDEN_WIFI_PASSWORD_FILE=/etc/warden/wifi-password
{% endif %}
{% endif %}
