
config globals 'globals'
	option mmx_mask '0x3F00'
{% for wan in wans %}

config interface 'wan_{{ wan.name }}'
	option enabled '1'
	option family 'ipv4'
{% for ip in track_ips %}
	list track_ip '{{ ip }}'
{% endfor %}
	option reliability '1'
	option count '1'
	option timeout '1'
	option interval '{{ wan.interval }}'
	option down '3'
	option up '5'
{% if loop.first %}
	list flush_conntrack 'disconnected'
{% endif %}
{% for position in range(1, wans | length + 1) %}

config member 'wan_{{ wan.name }}_m{{ position }}'
	option interface 'wan_{{ wan.name }}'
	option metric '{{ position }}'
	option weight '1'
{% endfor %}
{% endfor %}

config policy 'failover'
{% for wan in wans %}
	list use_member 'wan_{{ wan.name }}_m{{ loop.index }}'
{% endfor %}
	option last_resort 'unreachable'
{% for primary in (wan_preferences | default({})).values() | unique | sort %}
{% set order = [primary] + (wans | map(attribute='name') | reject('eq', primary) | list) %}

config policy 'prefer_{{ primary }}'
{% for name in order %}
	list use_member 'wan_{{ name }}_m{{ loop.index }}'
{% endfor %}
	option last_resort 'unreachable'
{% endfor %}
{% for device, primary in wan_preferences | default({}) | dictsort %}

config rule 'device_{{ device | replace('-', '_') }}'
	option src_ip '{{ dhcp_hosts[device].ip }}'
	option family 'ipv4'
	option use_policy 'prefer_{{ primary }}'
{% endfor %}

config rule 'default'
	option dest_ip '0.0.0.0/0'
	option family 'ipv4'
	option use_policy 'failover'
