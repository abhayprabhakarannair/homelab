
config dnsmasq
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '0'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
{% for name in rebind_domains %}
	list rebind_domain '{{ name }}'
{% endfor %}
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option nonegcache '0'
	option cachesize '1000'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option noresolv '1'
{% for resolver in doh_resolvers %}
	list server '127.0.0.1#{{ resolver.port }}'
{% endfor %}
	list server '/use-application-dns.net/'
	option nonwildcard '1'
	option localservice '1'
	option ednspacket_max '1232'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option dhcpv4 'server'
{% for wan in wans %}

config dhcp 'wan_{{ wan.name }}'
	option interface 'wan_{{ wan.name }}'
	option ignore '1'
{% endfor %}
{% for name, host in dhcp_hosts | dictsort %}

config host
	option name '{{ name }}'
	option mac '{{ host.mac | lower }}'
	option ip '{{ host.ip }}'
{% endfor %}
