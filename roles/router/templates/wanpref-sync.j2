#!/bin/sh
# Rebuilds the per-device ISP override rules from /tmp/wanpref/<ip> (contents: an ISP name).
# An override applies only while its ISP is tracked online; one whose address is no longer a DHCP reservation is
# deleted, since the next device leasing that address would inherit it.
# `wanpref-sync reserved <ip>` only tells whether ip is a reservation.
# mwan3 deletes rules in its 1000-3999 range when it stops, so this runs on every mwan3 interface event.

PRIORITY=1500

reserved() {
	uci -q show dhcp | grep "^dhcp\.@host\[[0-9]*\]\.ip=" | cut -d= -f2 | grep -qxF "'$1'"
}

if [ "$1" = reserved ]; then
	reserved "$2"
	exit
fi

table() {
	case "$1" in
{% for wan in wans %}
	{{ wan.name }}) echo {{ loop.index }} ;;
{% endfor %}
	esac
}

# warden reads the overrides unprivileged; older helpers created them root-only.
if [ -d /tmp/wanpref ]; then
	chmod 755 /tmp/wanpref
	chmod 644 /tmp/wanpref/* 2>/dev/null
fi

while ip rule del priority "$PRIORITY" 2>/dev/null; do :; done

for file in /tmp/wanpref/*; do
	[ -f "$file" ] || continue
	isp=$(cat "$file")
	id=$(table "$isp")
	[ -n "$id" ] || continue
	ip=${file##*/}
	reserved "$ip" || { rm -f "$file"; continue; }
	[ "$(cat "/var/run/mwan3track/wan_$isp/STATUS" 2>/dev/null)" = online ] || continue
	ip rule add from "$ip" lookup "$id" priority "$PRIORITY"
done
