#!/bin/sh
# rpcd exec plugin, run as root. Only the warden user may call it (/usr/share/acl.d/warden.json).
# `ubus call wanpref set '{"ip":"…","isp":"<isp>|auto"}'` routes one LAN device through one ISP. Only DHCP
# reservations can be routed (an override follows the address, which another device could lease next); auto is
# allowed for any LAN address.
# `ubus call wanpref degraded '{"isps":[…]}'` records the ISPs warden measures as degraded (lossy or slow while
# tracked online); overrides to them are suspended until they recover. A wrong list can only send devices back
# to their automatic order.

. /usr/share/libubox/jshn.sh

# rpcd runs plugins with umask 077; warden reads the overrides unprivileged.
umask 022

fail() {
	json_init
	json_add_string error "$1"
	json_dump
	exit 0
}

case "$1" in
list)
	echo '{ "set": { "ip": "str", "isp": "str" }, "degraded": { "isps": "array" } }'
	;;
call)
	read -r input
	json_load "$input" || fail "invalid JSON"
	if [ "$2" = degraded ]; then
		json_select isps || fail "isps must be a list"
		json_get_keys keys
		list=""
		for key in $keys; do
			json_get_var isp "$key"
			case "$isp" in
{% for wan in wans %}
			{{ wan.name }}) ;;
{% endfor %}
			*) fail "unknown isp" ;;
			esac
			list="$list$isp
"
		done
		json_select ..
		printf %s "$list" > /tmp/wanpref-degraded
		/usr/libexec/wanpref-sync
		json_init
		json_add_array isps
		for isp in $list; do json_add_string "" "$isp"; done
		json_close_array
		json_dump
		exit 0
	fi
	[ "$2" = set ] || fail "unknown method"
	json_get_var ip ip
	json_get_var isp isp
	prefix="{{ (lan_address | split('.'))[:3] | join('.') }}."
	octet=${ip#"$prefix"}
	case "$octet" in
	"$ip"|''|0*|*[!0-9]*) fail "not a LAN address" ;;
	esac
	[ "$octet" -ge 1 ] && [ "$octet" -le 254 ] || fail "not a LAN address"
	[ "$isp" = auto ] || /usr/libexec/wanpref-sync reserved "$ip" || fail "not a reserved address"
	case "$isp" in
	auto) rm -f "/tmp/wanpref/$ip" ;;
{% for wan in wans %}
	{{ wan.name }}) mkdir -p /tmp/wanpref && echo {{ wan.name }} > "/tmp/wanpref/$ip" && chmod 644 "/tmp/wanpref/$ip" ;;
{% endfor %}
	*) fail "unknown isp" ;;
	esac
	/usr/libexec/wanpref-sync
	json_init
	json_add_string ip "$ip"
	json_add_string isp "$isp"
	json_dump
	;;
esac
